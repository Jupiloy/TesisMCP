digraph ArquitecturaSistema {
    graph [
        bgcolor="#ffffff",
        rankdir=TB,
        splines=ortho,
        nodesep=0.7,
        ranksep=0.7,
        pad="0.3",
        fontname="Arial",
        fontsize=11
    ];

    node [
        shape=rectangle,
        style="solid",
        color="#000000",
        fontname="Arial",
        fontsize=10,
        penwidth=1.5,
        fillcolor="#ffffff"
    ];

    edge [
        color="#000000",
        fontname="Arial",
        fontsize=9,
        arrowsize=0.7,
        penwidth=1.2
    ];

    subgraph cluster_clientes {
        label="CAPAS DE CLIENTE";
        style="dashed";
        color="#000000";
        penwidth=1.5;
        fontname="Arial Bold";
        fontsize=11;
        margin=16;

        WebUI [label="Panel Admin y Clientes HTTP\n(Django Admin / Frontend REST)"];
        AIClient [label="Cliente LLM Asistido\n(Claude Desktop / Cursor / IDEs)"];
    }

    subgraph cluster_comunicacion {
        label="CAPA DE COMUNICACIÓN Y TRANSPORTE";
        style="dashed";
        color="#000000";
        penwidth=1.5;
        fontname="Arial Bold";
        fontsize=11;
        margin=16;

        MCP [label="Servidor MCP (MCPServer)\n17 Herramientas + 15 Prompts Dinámicos"];
        REST [label="API REST OpenAPI (/api/v1/)\nDjango Ninja (Endpoints Síncronos)"];
    }

    subgraph cluster_nucleo {
        label="NÚCLEO TRANSACCIONAL Y SERVICIOS DE DOMINIO";
        style="dashed";
        color="#000000";
        penwidth=1.5;
        fontname="Arial Bold";
        fontsize=11;
        margin=16;

        Bridge [label="Puente MCP & Seguridad\ndjango_bridge.py + mcp_auth.py (SHA-256)"];
        Services [label="Servicios de Dominio (thesis.services)\nContratos Pydantic extra='forbid' + reviews.py"];
        Discovery [label="Integradores de Exploración Científica\nOpenAlex + Semantic Scholar + ALICIA (Perú)"];
    }

    subgraph cluster_persistencia {
        label="PERSISTENCIA RELACIONAL Y AUDITORÍA";
        style="dashed";
        color="#000000";
        penwidth=1.5;
        fontname="Arial Bold";
        fontsize=11;
        margin=16;

        DB [label="PostgreSQL 16 (tesismcp_reducido_docente)\n15 Modelos / 17 Tablas Físicas (Prefijo tesis_)\nTriggers Append-Only en PL/pgSQL + lock_version"];
    }

    // Conexiones de flujo
    AIClient -> MCP [xlabel="JSON-RPC (stdio)"];
    AIClient -> REST [xlabel="HTTP JSON"];
    WebUI -> REST [xlabel="HTTP"];

    MCP -> Bridge;
    Bridge -> Services;
    REST -> Services;

    Services -> Discovery;
    Services -> DB [xlabel="Transacciones ACID\n(lock_version)"];
}
